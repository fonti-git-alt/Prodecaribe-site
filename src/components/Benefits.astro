---
const clusters = [
  { emoji: '🏨', name: 'Hotelera' },
  { emoji: '⛏️', name: 'Minería' },
  { emoji: '👕', name: 'Textil' },
  { emoji: '🐄', name: 'Agropecuaria' },
  { emoji: '🏭', name: 'Producción' },
  { emoji: '💊', name: 'Farmacéutica' },
  { emoji: '🏢', name: 'Bienes Raíces' },
  { emoji: '💻', name: 'Tecnología' },
];
---

<section id="beneficios" class="py-32 bg-[#FAFAFA] relative overflow-hidden" style="padding: 24px 0;">
  <!-- Background decoration -->
  <div class="absolute top-20 left-20 w-[600px] h-[600px] bg-[#F59E0B]/5 rounded-full blur-3xl"></div>
  <div class="absolute bottom-20 right-20 w-[400px] h-[400px] bg-[#0C4A6E]/5 rounded-full blur-3xl"></div>

  <div class="max-w-7xl mx-auto px-8 lg:px-12 relative z-10">
    <!-- Header -->
    <div class="text-center mb-6" data-animate>
      <span class="inline-block bg-[#0C4A6E]/8 text-[#0C4A6E] px-5 py-2 rounded-full text-sm font-semibold mb-4">Club de Inversión</span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-[#0A1628] mb-3 tracking-tight">
        Ser miembro tiene <span class="text-[#F59E0B]">beneficios</span>
      </h2>
      <p class="text-[#64748B] text-base max-w-2xl mx-auto leading-relaxed">
        Accedé a oportunidades de inversión en los sectores que transforman el Caribe colombiano.
      </p>
    </div>

    <!-- 8 Clusters section -->
    <div class="bg-gradient-to-br from-[#0A1628] to-[#0C4A6E] rounded-2xl p-7 lg:p-9 relative overflow-hidden mb-5" data-animate>
      <!-- Background decoration -->
      <div class="absolute inset-0 opacity-10">
        <div class="absolute top-0 right-0 w-64 h-64 bg-[#F59E0B] rounded-full blur-3xl"></div>
      </div>

      <div class="relative z-10">
        <h3 class="text-2xl lg:text-3xl font-bold text-white mb-4 text-center">
          Los 8 clusters de inversión del Caribe
        </h3>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          {clusters.map((cluster) => (
            <div class="bg-white/10 backdrop-blur-sm rounded-xl p-3.5 border border-white/10 hover:bg-white/20 transition-all duration-300 group text-center">
              <div class="text-2xl mb-1 transform group-hover:scale-110 transition-transform">{cluster.emoji}</div>
              <h4 class="font-bold text-white text-sm">{cluster.name}</h4>
            </div>
          ))}
        </div>

        <p class="text-center text-white/50 mt-4 text-xs">
          <span class="text-[#F59E0B] font-medium">Tu primera inversión:</span> Desde USD 20 para acceder al club
        </p>
      </div>
    </div>

    <!-- Main benefits -->
    <div class="grid md:grid-cols-3 gap-3" data-stagger>
      <!-- Benefit 1 -->
      <div class="bg-white rounded-xl p-4 border border-[#E2E8F0] hover:border-[#0C4A6E]/20 hover:shadow-lg hover:shadow-[#0C4A6E]/5 transition-all duration-500 flex items-start gap-4 md:flex-col md:items-center md:text-center">
        <div class="w-10 h-10 bg-[#0C4A6E] rounded-xl flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-bold text-[#0A1628] mb-0.5">Generar Riqueza</h3>
          <p class="text-[#64748B] text-xs leading-relaxed">
            Inversiones desde USD 5,000 con alto potencial de retorno.
          </p>
        </div>
      </div>

      <!-- Benefit 2 (Comprar y Vender) -->
      <div class="bg-white rounded-xl p-4 border border-[#E2E8F0] hover:border-[#F59E0B]/30 hover:shadow-lg hover:shadow-[#F59E0B]/5 transition-all duration-500 flex items-start gap-4 md:flex-col md:items-center md:text-center">
        <div class="w-10 h-10 bg-[#F59E0B] rounded-xl flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-bold text-[#0A1628] mb-0.5">Comprar y Vender</h3>
          <p class="text-[#64748B] text-xs leading-relaxed">
            Red de contactos para comprar y vender en los 8 clusters.
          </p>
        </div>
      </div>

      <!-- Benefit 3 (Comunidad Exclusiva) -->
      <div class="bg-white rounded-xl p-4 border border-[#E2E8F0] hover:border-green-500/30 hover:shadow-lg hover:shadow-green-500/5 transition-all duration-500 flex items-start gap-4 md:flex-col md:items-center md:text-center">
        <div class="w-10 h-10 bg-green-500 rounded-xl flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-bold text-[#0A1628] mb-0.5">Comunidad Exclusiva</h3>
          <p class="text-[#64748B] text-xs leading-relaxed">
            Networking de alto nivel con empresarios y líderes del Caribe.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
