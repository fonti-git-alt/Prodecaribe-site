---
const WHATSAPP_NUMBER = '573117224593';
const WHATSAPP_MESSAGE = encodeURIComponent('Hola! Quiero conocer más sobre Prodecaribe');
const WHATSAPP_URL = `https://wa.me/${WHATSAPP_NUMBER}?text=${WHATSAPP_MESSAGE}`;
---

<!-- WhatsApp Floating Button -->
<a 
  href={WHATSAPP_URL} 
  target="_blank" 
  rel="noopener noreferrer"
  class="whatsapp-float"
  aria-label="Contactar por WhatsApp"
>
<!-- WhatsApp Icon - using official SVG paths -->
  <svg class="wa-icon" viewBox="0 0 512 512" fill="none">
    <path fill="#EDEDED" d="M0,512l35.31-128C12.359,344.276,0,300.138,0,254.234C0,114.759,114.759,0,255.117,0S512,114.759,512,254.234S395.476,512,255.117,512c-44.138,0-86.51-14.124-124.469-35.31L0,512z"/>
    <path fill="#55CD6C" d="M137.71,430.786l7.945,4.414c32.662,20.303,70.621,32.662,110.345,32.662c115.641,0,211.862-96.221,211.862-213.628S371.641,44.138,255.117,44.138S44.138,137.71,44.138,254.234c0,40.607,11.476,80.331,32.662,113.876l5.297,7.945l-20.303,74.152L137.71,430.786z"/>
    <path fill="#FEFEFE" d="M187.145,135.945l-16.772-0.883c-5.297,0-10.593,1.766-14.124,5.297c-7.945,7.062-21.186,20.303-24.717,37.959c-6.179,26.483,3.531,58.262,26.483,90.041s67.09,82.979,144.772,105.048c24.717,7.062,44.138,2.648,60.028-7.062c12.359-7.945,20.303-20.303,22.952-33.545l2.648-12.359c0.883-3.531-0.883-7.945-4.414-9.71l-55.614-25.6c-3.531-1.766-7.945-0.883-10.593,2.648l-22.069,28.248c-1.766,1.766-4.414,2.648-7.062,1.766c-15.007-5.297-65.324-26.483-92.69-79.448c-0.883-2.648-0.883-5.297,0.883-7.062l21.186-23.834c1.766-2.648,2.648-6.179,1.766-8.828l-25.6-57.379C193.324,138.593,190.676,135.945,187.145,135.945"/>
  </svg>
  
  <span class="wa-text hidden sm:inline">Escríbenos</span>
</a>

<style>
  .whatsapp-float {
    animation: slideUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes slideUp {
    from { opacity: 0; transform: translateY(40px) scale(0.8); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }

  /* ── Mobile: icon-only, circular ── */
  @media (max-width: 639px) {
    .whatsapp-float {
      position: fixed;
      bottom: 1.25rem;
      right: 1.25rem;
      width: 56px;
      height: 56px;
      padding: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0;
      background: #25D366;
      border: none;
      border-radius: 50%;
      box-shadow: 0 4px 20px rgba(37, 211, 102, 0.5);
      text-decoration: none;
      z-index: 9999;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .whatsapp-float:active {
      transform: scale(0.92);
      box-shadow: 0 2px 12px rgba(37, 211, 102, 0.4);
    }

    .whatsapp-float .wa-icon {
      width: 28px;
      height: 28px;
      flex-shrink: 0;
    }

    .whatsapp-float .wa-text {
      display: none;
    }
  }

  /* ── Desktop: pill with text ── */
  @media (min-width: 640px) {
    .whatsapp-float {
      position: fixed;
      bottom: 2rem;
      right: 2rem;
      padding: 0.875rem 1.5rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      background: #25D366;
      border: 2px solid #5FE88A;
      border-radius: 9999px;
      color: white;
      text-decoration: none;
      box-shadow: 0 8px 32px rgba(37, 211, 102, 0.4);
      z-index: 9999;
      transition: background 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    }

    .whatsapp-float:hover {
      background: #20BD5A;
      box-shadow: 0 12px 40px rgba(37, 211, 102, 0.5);
      transform: scale(1.05);
    }

    .whatsapp-float .wa-icon {
      width: 26px;
      height: 26px;
      flex-shrink: 0;
    }

    .whatsapp-float .wa-text {
      font-size: 1rem;
      font-weight: 700;
      letter-spacing: -0.01em;
      white-space: nowrap;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';

  gsap.from('.whatsapp-float', {
    opacity: 0,
    y: 60,
    duration: 1,
    delay: 0.5,
    ease: 'power3.out',
  });
</script>
