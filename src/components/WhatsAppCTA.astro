---
const WHATSAPP_NUMBER = '573106212467';
const WHATSAPP_URL = `https://wa.me/${WHATSAPP_NUMBER}`;
---

<!-- WhatsApp Floating Button -->
<a 
  href={WHATSAPP_URL} 
  target="_blank" 
  rel="noopener noreferrer"
  class="whatsapp-float"
  aria-label="Contactar por WhatsApp"
>
  <!-- WhatsApp Icon -->
  <svg class="wa-icon" viewBox="0 0 32 32" fill="white">
    <path d="M28.5 5.5A14.5 14.5 0 0 0 16 2C8.27 2 2 8.27 2 16c0 2.56.67 4.97 1.84 7.07L2.5 30l6.78-1.78A13.96 13.96 0 0 0 16 30c7.73 0 14-6.27 14-14S23.73 5.5 16 5.5zm0 26.1a11.6 11.6 0 0 1-5.93-1.61l-.34-.2-4.17 1.09.07-.38.33-.33A11.55 11.55 0 0 1 4.9 16c0-6.37 5.17-11.54 11.54-11.54S27.98 9.63 27.98 16c0 1.76-.46 3.41-1.26 4.87l-1.36 3.98 4.26-1.12-.18-.38z"/>
    <path d="M23.55 19.24c-.25-.13-1.48-.74-1.71-.83-.23-.09-.4-.13-.57.13-.16.25-.63.82-.77.99-.15.17-.29.19-.54.06-.25-.13-1.05-.39-2-.99-.74-.57-1.24-1.27-1.39-1.49-.15-.22-.02-.34.1-.45.11-.11.25-.28.37-.43.12-.15.16-.25.24-.42.08-.16.04-.31-.01-.43-.05-.12-.56-1.36-.76-1.86-.2-.49-.4-.42-.55-.44-.15-.01-.31-.01-.48-.01-.17 0-.44.06-.67.3-.23.24-.88.85-.88 2.07 0 1.22.9 2.41 1.02 2.56.13.17 1.78 2.71 4.31 3.8.6.26 1.08.42 1.45.54.61.19 1.16.16 1.6.1.49-.07 1.48-.6 1.69-1.18.21-.58.21-1.08.15-1.19-.05-.1-.23-.16-.48-.28z"/>
  </svg>
  
  <span class="wa-text hidden sm:inline">Escríbenos</span>
</a>

<style>
  .whatsapp-float {
    animation: slideUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes slideUp {
    from { opacity: 0; transform: translateY(40px) scale(0.8); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }

  /* ── Mobile: icon-only, circular ── */
  @media (max-width: 639px) {
    .whatsapp-float {
      position: fixed;
      bottom: 1.25rem;
      right: 1.25rem;
      width: 56px;
      height: 56px;
      padding: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0;
      background: #25D366;
      border: none;
      border-radius: 50%;
      box-shadow: 0 4px 20px rgba(37, 211, 102, 0.5);
      text-decoration: none;
      z-index: 9999;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .whatsapp-float:active {
      transform: scale(0.92);
      box-shadow: 0 2px 12px rgba(37, 211, 102, 0.4);
    }

    .whatsapp-float .wa-icon {
      width: 28px;
      height: 28px;
      flex-shrink: 0;
    }

    .whatsapp-float .wa-text {
      display: none;
    }
  }

  /* ── Desktop: pill with text ── */
  @media (min-width: 640px) {
    .whatsapp-float {
      position: fixed;
      bottom: 2rem;
      right: 2rem;
      padding: 0.875rem 1.5rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      background: #25D366;
      border: 2px solid #5FE88A;
      border-radius: 9999px;
      color: white;
      text-decoration: none;
      box-shadow: 0 8px 32px rgba(37, 211, 102, 0.4);
      z-index: 9999;
      transition: background 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    }

    .whatsapp-float:hover {
      background: #20BD5A;
      box-shadow: 0 12px 40px rgba(37, 211, 102, 0.5);
      transform: scale(1.05);
    }

    .whatsapp-float .wa-icon {
      width: 26px;
      height: 26px;
      flex-shrink: 0;
    }

    .whatsapp-float .wa-text {
      font-size: 1rem;
      font-weight: 700;
      letter-spacing: -0.01em;
      white-space: nowrap;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';

  gsap.from('.whatsapp-float', {
    opacity: 0,
    y: 60,
    duration: 1,
    delay: 0.5,
    ease: 'power3.out',
  });
</script>
